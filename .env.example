# Ambiente: development | test | production
NODE_ENV=development
PORT=3000
# URL pública da API (usada para montar as URLs das imagens)
APP_URL=http://localhost:3000

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=store_api
DB_USER=root
DB_PASSWORD=root
# Defina como true para logar as queries SQL no console
DB_LOGGING=false

# Autenticação
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Pasta onde as imagens dos produtos são gravadas
UPLOAD_DIR=uploads
